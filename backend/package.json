{
    "name": "hospilink-backend",
    "version": "1.0.0",
    "description": "Hospital Management Backend",
    "main": "server.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand --forceExit",
        "lint": "eslint . --max-warnings 0",
        "test:watch": "jest --watch"
    },
    "jest": {
        "testEnvironment": "node",
        "modulePaths": [
            "<rootDir>/node_modules"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "tests/integration/db.js"
        ]
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1046.0",
        "@aws-sdk/client-sesv2": "^3.1052.0",
        "@aws-sdk/s3-request-presigner": "^3.1046.0",
        "@google-cloud/vision": "^4.3.3",
        "@google/generative-ai": "^0.24.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "axios": "^1.16.1",
        "bcryptjs": "^2.4.3",
        "canvas": "^3.2.3",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "express-rate-limit": "^6.11.2",
        "express-validator": "^7.3.2",
        "file-type": "16.5.4",
        "firebase-admin": "^13.9.0",
        "form-data": "^4.0.5",
        "helmet": "^7.2.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "jsqr": "^1.4.0",
        "mammoth": "^1.12.1",
        "mongoose": "^7.8.9",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^10.0.10",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^1.1.1",
        "pdfjs-dist": "^3.11.174",
        "pino": "^10.3.1",
        "puppeteer-core": "^24.43.1",
        "rate-limit-redis": "^4.3.1",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
        "turndown": "^7.2.4",
        "twilio": "^5.13.1",
        "uuid": "^9.0.1",
        "validator": "^13.15.35",
        "winston": "^3.19.0",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "jest": "^30.4.2",
        "mongodb-memory-server": "^11.3.0"
    },
    "config": {
        "mongodbMemoryServer": {
            "version": "8.0.4"
        }
    }
}
